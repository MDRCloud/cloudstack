  "theme": {
    "@layout-mode": "dark",
    "@logo-background-color": "#0a0d18",
    "@mini-logo-background-color": "#0a0d18",
    "@navigation-background-color": "#0a0d18",
    "@project-nav-background-color": "#02040a",
    "@project-nav-text-color": "rgba(248, 250, 252, 0.65)",
    "@navigation-text-color": "rgba(248, 250, 252, 0.65)",
    "@primary-color": "#3b82f6",
    "@link-color": "#60a5fa",
    "@link-hover-color": "#00adef",
    "@loading-color": "#3b82f6",
    "@processing-color": "#3b82f6",
    "@success-color": "#10b981",
    "@warning-color": "#f59e0b",
    "@error-color": "#ef4444",
    "@font-size-base": "14px",
    "@heading-color": "#f8fafc",
    "@text-color": "#f8fafc",
    "@text-color-secondary": "#94a3b8",
    "@disabled-color": "rgba(0, 0, 0, 0.25)",
    "@border-color-base": "#d9d9d9",
    "@border-radius-base": "4px",
    "@box-shadow-base": "0 2px 8px rgba(0, 0, 0, 0.15)",
    "@logo-width": "64px",
    "@logo-height": "64px",
    "@mini-logo-width": "64px",
    "@mini-logo-height": "64px",
    "@banner-width": "160px",
    "@banner-height": "160px",
    "@error-width": "256px",
    "@error-height": "256px"
  },
  "keyboardOptions": {
    "us": "label.standard.us.keyboard",
    "uk": "label.uk.keyboard",
    "fr": "label.french.azerty.keyboard",
    "jp": "label.japanese.keyboard",
    "sc": "label.simplified.chinese.keyboard",
    "es-latam": "Spanish Latin American Keyboard"
  },
  "userCard": {
    "enabled": true,
    "title": "label.help",
    "icon": "question-circle-outlined",
    "links": [
      {
        "title": "Documentation",
        "text": "CloudStack documentation website",
        "link": "https://docs.cloudstack.apache.org/en/latest/",
        "icon": "read-outlined"
      },
      {
        "title": "API Documentation",
        "text": "Refer to API documentation",
        "link": "https://cloudstack.apache.org/api.html",
        "icon": "api-outlined"
      },
      {
        "title": "Email Support",
        "text": "Join CloudStack users mailing list to seek and provide support",
        "link": "mailto:users-subscribe@cloudstack.apache.org",
        "icon": "mail-outlined"
      },
      {
        "title": "Report Issue",
        "text": "Submit a bug or improvement request",
        "link": "https://github.com/apache/cloudstack/issues/new",
        "icon": "bug-outlined"
      }
    ]
  },
  "plugins": [],
  "allowMakingRouterRedundant": false,
