  "loginFavicon": "assets/mdrc-logo.png",
  "loginFooter": "",
  "resetPasswordFooter": "",
  "logo": "assets/mdrc-logo.png",
  "minilogo": "assets/mdrc-logo.png",
  "banner": "assets/mdrc-logo.png",
  "favicon": "cloud.ico",
  "error": {
    "403": "assets/403.png",
    "404": "assets/404.png",
    "500": "assets/500.png"
